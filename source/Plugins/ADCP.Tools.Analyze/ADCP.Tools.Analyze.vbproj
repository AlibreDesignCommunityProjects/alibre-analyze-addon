<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace></RootNamespace>
    <AssemblyName>ADCP.Tools.Analyze</AssemblyName>
    <OutputType>Library</OutputType>
    <TargetFramework>net481</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup>
    <AlibreRefDir Condition="'$(AlibreProgramDir)' != '' And Exists('$(AlibreProgramDir)\AlibreX.dll')">$(AlibreProgramDir)</AlibreRefDir>
    <AlibreRefDir Condition="'$(AlibreRefDir)' == ''">$([System.IO.Directory]::GetDirectories('C:\Program Files', 'Alibre Design*')[0])\Program</AlibreRefDir>
    <AlibreRefDir Condition="'$(AlibreRefDir)' == '' Or !Exists('$(AlibreRefDir)\AlibreX.dll')">$(MSBuildThisFileDirectory)..\..\lib</AlibreRefDir>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Analyze.adc" />
    <None Remove="logo.ico" />
    <None Remove="logo.png" />
    <Content Include="Analyze.adc">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="logo.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="AlibreAddOn">
      <HintPath>$(AlibreRefDir)\AlibreAddOn.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="AlibreX">
      <HintPath>$(AlibreRefDir)\AlibreX.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>
